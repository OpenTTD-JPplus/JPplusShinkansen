##grflangid 0x56
##plural 1
# Guide: https://newgrf-specs.tt-wiki.net/wiki/NML:Language_files

# #######################
# JP+ Shinkansen SIMPLIFIED CHINESE TRANSLATION NOTES
# 翻译时请尽量在中西文中间加入空格，以便于在不同语言之间的切换。
# 请尽量使用中文标点符号。
# 对于某些列车型号或涂装，可以加入日文原名。
# 请保证译文自然流畅。即使使用机翻也请校对过后再提交。
# #######################

# GRF name and description definitions
STR_GRF_NAME        :JP+ 新干线 {VERSION}
STR_GRF_DESC        :{WHITE}JP{RED}+{WHITE} 新干线{}{}JP{RED}+{WHITE}新干线{BLACK}专门做的就是，您应该已经门儿清了，新干线！本包中的列车需要高速铁道。{}本包是{WHITE}JP{RED}+{WHITE} 动车组（{WHITE}JP{RED}+{WHITE} MUs）{BLACK}、{WHITE}JP{RED}+ {WHITE}机车与车厢{BLACK}与{WHITE}JP{RED}+ {WHITE}主要私铁（{WHITE}JP{RED}+{WHITE} Major Private Companies）{BLACK}的姊妹拓展包。{}{}{BLACK}{COPYRIGHT}JP+ 新干线{}许可证：GPLv2{}{BLACK}{}程序：{}{LTBLUE}KeepinItRail{}{}{BLACK}图像：{}{GREEN}KeepinItRail, Yozora, Azusa, Erato{}{}{BLACK}翻译：{}{GREEN}freeaim (Japanese){}Yozora (Russian){}CoconutKR (Korean){}{}{TINYFONT}{BLACK}特别感谢：{}{ORANGE}Emperor Jake{}Tinny{}Saya{}Leon{}JapanSet3 Team{}{}{}{BLACK}{}

# Parameters
STR_NO                              :否
STR_YES                             :是
AND                                 : &
STR_PARAM_NORMAL                    :正常
STR_PARAM_VLOW                      :非常低
STR_PARAM_LOW                       :低
STR_PARAM_HIGH                      :高
STR_PARAM_VHIGH                     :非常高
STR_PARAM_NAME_BASECOSTMODBUY       :购买费用
STR_PARAM_DESC_BASECOSTMODBUY       :改变载具购置成本。
STR_PARAM_NAME_BASECOSTMODRUN       :运行费用
STR_PARAM_DESC_BASECOSTMODRUN       :改变载具运行成本。
STR_PARAM_NAME_BASECAPACITY         :旅客容量
STR_PARAM_DESC_BASECAPACITY         :调整旅客容量。“真实”是基于现实中的新干线列车的容量，且没有考虑游戏平衡。
STR_PARAM_NAME_JAPANSETDISABLE      :移除 JapanSet3 新干线
STR_PARAM_DESC_JAPANSETDISABLE      :禁用 JapanSet3 新干线列车；游戏中出现的所有新干线列车将为 JP+ 新干线列车。
STR_PARAM_NAME_DECAY                :货物保鲜度
STR_PARAM_DESC_DECAY                :设置货物保鲜度。在“正常”模式下，所有火车具有相同的保鲜度。在使用“低”和“非常低”时货物保鲜度取决于使用的火车类型，此时在较长距离下使用通勤列车将比使用快速列车赚取更少。

STR_PARAM_REAL                      :真实（1x）
STR_PARAM_1_50                      :长图像优化（1.5x）
STR_PARAM_DOUBLE                    :双倍（2x）
STR_PARAM_1_25                      :长图像优化（1.25x）

# Hide Logos
STR_PARAM_HIDE_LOGO                 :在购买菜单内显示公司标志

STR_PARAM_NAME_DRYELLOW             :{PUSH_COLOUR}{YELLOW}黄医生{POP_COLOUR}作用
STR_PARAM_DESC_DRYELLOW             :选择如何使用“黄医生”。

STR_PARAM_GIMMICK                   :轨道测试车（默认）
STR_PARAM_MAIL                      :邮政列车
STR_PARAM_PASSENGERS                :旅客列车

# Error Messages
GRF_OTTDVER                 :你的 OpenTTD 版本不支持此 GRF。请升级到更高版本。
STR_LENGTH_ERROR            :需要增加更多新干线车厢！从购买菜单中购买更多的新干线车厢，并保证一列车中至少有四个车厢。
COUPLE_CANT_JOIN            :不能添加到重联新干线！

# Mucar
MU_UNIQUE                   :你只能连接新干线车厢或重联新干线列车
ONLY_ADD_MUCAR              :你只能连接新干线车厢
ONLY_ADD_MUCAR_MINI         :只可连接 JP+ 迷你新干线车厢
ONLY_ADD_MUCAR_FULL         :只可连接 JP+ 新干线车厢
MUCAR_MINI                  :JP+ 迷你新干线车厢{WHITE}（动车组）{BLACK}
MUCAR_FULL                  :JP+ 新干线车厢{WHITE}（动车组）{BLACK}
MUCAR_MAIL                  :JP+ 新干线邮车{WHITE}（动车组）{BLACK}
MUCAR_MAGLEV                :JP+ 新干线磁悬浮车厢{WHITE}（动车组）{BLACK}

