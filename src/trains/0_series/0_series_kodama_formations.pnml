/* Cab selection */

/* Find the cabs */

	switch (FEAT_TRAINS, SELF, sw_0_series_kodama_cabs, position_in_consist) {
		0..2: sw_0_series_kodama_cab001;
		sw_0_series_kodama_cab002;
	}

	switch (FEAT_TRAINS, SELF, sw_0_series_kodama_graphics, IsCab() ) {
		1:  sw_0_series_kodama_cabs;
		sw_0_series_kodama_midcars;
	}
