/* Cab selection */

/* Find the cabs */

	switch (FEAT_TRAINS, SELF, sw_922_series_cabs, position_in_consist) {
		0..2: sw_922_series_cab001;
		sw_922_series_cab002;
	}

	switch (FEAT_TRAINS, SELF, sw_922_series_graphics, IsCab() ) {
