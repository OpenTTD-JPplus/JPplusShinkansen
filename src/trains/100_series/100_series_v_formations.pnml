
    switch (FEAT_TRAINS, SELF, sw_100_series_v_others, EvenCarForward() ) {
            1:  sw_100_series_v_panto1;
            sw_100_series_v_coach1;
        }

    switch (FEAT_TRAINS, SELF, sw_100_series_v_9_and_10, CarNumber() == 5 || CarNumber() == 6 ) {				
            0:  sw_100_series_v_others;
            sw_100_series_v_coach2;				
        }

    switch (FEAT_TRAINS, SELF, sw_100_series_v_11_to_14, CarNumber() ) {				
            5: sw_100_series_v_coach2;
            6: sw_100_series_v_coach2;
            7: sw_100_series_v_coach3;
            8: sw_100_series_v_coach2;
            sw_100_series_v_others;				
        }

    switch (FEAT_TRAINS, SELF, sw_100_series_v_15plus, CarNumber() ) {				
            7: sw_100_series_v_coach2;
            8: sw_100_series_v_coach2;
            9: sw_100_series_v_coach3;
            10: sw_100_series_v_coach2;
            sw_100_series_v_others;				
        }

    switch (FEAT_TRAINS, SELF, sw_100_series_v_midcars, NumberCarsInConsist() ) {				
            0..8:  sw_100_series_v_others;
            9..10: sw_100_series_v_9_and_10;
            11..14: sw_100_series_v_11_to_14;
            sw_100_series_v_15plus;
        }

/* Cab selection */

/* Find the cabs */

	switch (FEAT_TRAINS, SELF, sw_100_series_v_cabs, position_in_consist) {
		0..2: sw_100_series_v_cab001;
		sw_100_series_v_cab002;
	}

	switch (FEAT_TRAINS, SELF, sw_100_series_v_graphics, IsCab() ) {
		1:  sw_100_series_v_cabs;
		sw_100_series_v_midcars;
	}
